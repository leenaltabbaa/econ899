# Files Git should not track.

# R and RStudio
.Rhistory
.RData
.Rproj.user/

# Mac system files
.DS_Store

# Data for analysis and results are generated by the code (programs/01_main.R),
# so they are not included. Keep the README in each folder.
data/data_for_analysis/*
!data/data_for_analysis/README.md
results/*
!results/README.md
